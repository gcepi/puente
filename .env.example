# Copy to .env for local runs. On Render, set these in the dashboard instead.
# Never commit real keys.

# mock | openai-translate | pipeline   (the host can also pick per meeting)
ENGINE=mock
# Optional: require a passcode to START a meeting (joining only needs the room code)
HOST_PASSCODE=
# Optional: the public https address, used in the QR code (auto-detected on Render)
PUBLIC_URL=
MAX_SESSION_MINUTES=120

# --- Engine: openai-translate (one key) ---
OPENAI_API_KEY=

# --- Engine: pipeline (speech recognition -> Claude -> voice) ---
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-haiku-5-5
# Pause (ms) that ends a phrase in "When I pause" mode. Lower = faster, choppier.
ENDPOINTING_MS=700
MAX_PHRASE_WORDS=35
# Voice: elevenlabs (best quality, choose a Mexican voice) | openai (uses OPENAI_API_KEY)
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_REPLY_VOICE_ID=
TTS_SPEED=1.08
OPENAI_TTS_VOICE=coral
