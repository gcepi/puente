# Copy to .env for local runs. On Render, set these in the dashboard instead.
# Never commit real keys.

# Use mock to practice locally, or turn for push-to-talk translation.
ENGINE=mock
# Optional: require a passcode to START a meeting (joining only needs the room code)
HOST_PASSCODE=
# Optional: the public https address, used in the QR code (auto-detected on Render)
PUBLIC_URL=
# Standing 3-digit room code the crew always joins with; 'random' = new code each meeting
ROOM_CODE=750
MAX_SESSION_MINUTES=120

# --- Push-to-talk translation ---
OPENAI_API_KEY=
# Setting both selects ElevenLabs for the Spanish voice, with OpenAI as backup.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional separate English voice for crew replies. Defaults to the same voice.
ELEVENLABS_REPLY_VOICE_ID=
TTS_SPEED=1.08

# --- Engine: pipeline (speech recognition -> Claude -> voice) ---
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-haiku-5-5
# Pause (ms) that ends a phrase in "When I pause" mode. Lower = faster, choppier.
ENDPOINTING_MS=700
MAX_PHRASE_WORDS=35
# This selector applies to the pipeline engine only.
TTS_PROVIDER=openai
OPENAI_TTS_VOICE=coral
